# Copy to infrastructure/.env and fill in. Never commit .env.
POSTGRES_DB=fitness_formulasi
POSTGRES_USER=ff_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Only for the optional `api` compose profile:
# Generate with: openssl rand -base64 48
# AES-256 key for payment integration secrets (Click, Payme). Generate with: openssl rand -base64 32
# Keep it stable: if it changes, saved integration secrets must be entered again.
INTEGRATIONS_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
API_ENVIRONMENT=Production
API_PORT=8080
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_ORIGIN=http://localhost:5173
