# Copy to infrastructure/.env and fill in. Never commit .env.
POSTGRES_DB=fitness_formulasi
POSTGRES_USER=ff_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Only for the optional `api` compose profile:
# Generate with: openssl rand -base64 48
# AES-256 key for payment integration secrets (Click, Payme). Generate with: openssl rand -base64 32
# Keep it stable: if it changes, saved integration secrets must be entered again.
INTEGRATIONS_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
API_ENVIRONMENT=Production
API_PORT=8080
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_ORIGIN=http://localhost:5173

# AI Food Scanner (docs/NUTRITION.md). Without a key photo analysis is off; the food diary and barcodes still work.
# Simplest: set the provider and key in the admin panel (Настройки → Интеграции → ИИ-анализ еды); it needs
# INTEGRATIONS_ENCRYPTION_KEY above. Or here: AI_PROVIDER=OpenAI with a key from platform.openai.com/api-keys
# (ChatGPT), or AI_PROVIDER=Anthropic with a key from console.anthropic.com (Claude). The key is a secret: never commit it.
AI_PROVIDER=None
AI_API_KEY=
# Empty: the provider's default (OpenAI: gpt-6.1-terra for photos, gpt-6.2-sol for the consultant; Anthropic: claude-opus-5-5).
AI_VISION_MODEL=
AI_CHAT_MODEL=
# Spending cap for all clients per calendar month, USD (0 = no cap).
AI_MONTHLY_BUDGET_USD=100
# Optional: free key from https://api.data.gov/signup for searching USDA FoodData Central beyond the built-in database.
USDA_API_KEY=
